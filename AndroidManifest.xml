<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="io.github.vivibibi30.hyperpguard"
    android:versionCode="76"
    android:versionName="1.8.9">

    <uses-sdk android:minSdkVersion="29" android:targetSdkVersion="34" />

    <uses-permission android:name="android.permission.INTERNET" />

<queries>
        <package android:name="com.baidu.input_mi" />
        <package android:name="com.iflytek.inputmethod.miui" />
        <package android:name="com.miui.analytics" />
        <package android:name="com.miui.dmregservice" />
        <package android:name="com.miui.guardprovider" />
        <package android:name="com.miui.misightservice" />
        <package android:name="com.miui.packageinstaller" />
        <package android:name="com.miui.securitycenter" />
        <package android:name="com.miui.systemAdSolution" />
        <package android:name="com.miui.wmsvc" />
        <package android:name="com.mobiletools.systemhelper" />
        <package android:name="com.sohu.inputmethod.sogou.xiaomi" />
        <package android:name="com.xiaomi.aiasst.vision" />
        <package android:name="com.xiaomi.aicr" />
        <package android:name="com.xiaomi.market" />
        <package android:name="com.xiaomi.registration" />
        <package android:name="com.xiaomi.trustservice" />
        <package android:name="com.xiaomi.type" />
        <package android:name="com.xiaomi.xmsf" />
        <package android:name="com.tencent.wetype" />
        <package android:name="com.bytedance.android.doubaoime" />
    </queries>

    <application
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:description="@string/app_desc"
        android:hasCode="true"
        android:allowBackup="false"
        android:theme="@android:style/Theme.DeviceDefault.Light.NoActionBar">

        <provider
            android:name="io.github.libxposed.service.XposedProvider"
            android:authorities="io.github.vivibibi30.hyperpguard.XposedService"
            android:exported="true" />

        <!-- 桌面入口只在 alias 上，隐藏图标即禁用它；本 Activity 保留 LSPosed 模块页入口 -->
        <activity
            android:name=".MainActivity"
            android:configChanges="uiMode|orientation|screenSize|smallestScreenSize|keyboardHidden"
            android:exported="true"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="de.robv.android.xposed.category.MODULE_SETTINGS" />
            </intent-filter>
        </activity>

        <activity-alias
            android:name=".Launcher"
            android:targetActivity=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:icon="@mipmap/ic_launcher">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
    </application>
</manifest>
